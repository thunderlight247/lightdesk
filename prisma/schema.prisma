generator client {
  provider = "prisma-client"
  runtime = "cloudflare"
  // Prisma 7 engine-less generated client (Query Compiler WASM + driver adapters —
  // no Query Engine binary, so it runs in workerd). Output is gitignored; the
  // `postinstall` / `build` scripts regenerate it. Runtime routing: lib/db/client.ts.
  output = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum ProfileStatus {
  DRAFT
  REVIEW_REQUIRED
  ACTIVE
  SUSPENDED
}

enum ProfileModule {
  IDENTITY
  OFFERINGS
  COMMUNICATION
  POLICY
  PERMISSION
}

enum ReviewState {
  DRAFT
  APPROVED
}

enum LabConversationStatus {
  ACTIVE
  ESCALATED
  RESOLVED
}

enum LabMessageRole {
  CUSTOMER
  ASSISTANT
}

enum LabDraftState {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum LabDraftSource {
  AI
  RULES
}

enum LabResultStatus {
  ANSWERABLE
  NEEDS_INFORMATION
  CONFLICT_DETECTED
  ESCALATION_REQUIRED
}

enum LabGenerationStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique // always stored lowercase (CHECK in migration 2)
  name            String
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions            Session[]
  memberships         BusinessMembership[]
  invitationsSent     Invitation[]         @relation("InvitationInviter")
  invitationsAccepted Invitation[]         @relation("InvitationAcceptor")
  auditEvents         AuditEvent[]
  pilotFeedback       PilotFeedback[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256 hex of the cookie token; plaintext never stored
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---- M8 Phase 3: login throttling ------------------------------------------------------
// One row per FAILED sign-in attempt only (successes are not throttling data). The
// rolling windows in modules/identity/throttle.ts count these per client ip and per
// attempted address; rows are pruned by housekeeping after the longest window.
// Deliberately NOT an AuditEvent: operational, high-volume, prunable.
model LoginFailure {
  id        String   @id @default(cuid())
  ip        String   // client ip as seen by the server; "unknown" when no proxy header
  email     String   // lowercased attempted address (the login schema normalises it)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
}

model Business {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String? // M1: optional, <=500 chars (CHECK)
  location    String? // M1: optional free text, <=120 chars (CHECK)
  status      BusinessStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  memberships           BusinessMembership[]
  invitations           Invitation[]
  auditEvents           AuditEvent[]
  profile               BusinessProfile?
  labConversations      LabConversation[]
  whatsappConnections   WhatsAppConnection[]
  whatsappConversations WhatsAppConversation[]
  // M7 Controlled Pilot: enrollment/consent, hard usage caps and owner feedback.
  pilotEnrollment       PilotEnrollment?
  usageCaps             UsageCaps?
  pilotFeedback         PilotFeedback[]
}

model BusinessMembership {
  id         String         @id @default(cuid())
  businessId String
  userId     String
  role       MembershipRole
  createdAt  DateTime       @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model Invitation {
  id           String         @id @default(cuid())
  businessId   String
  email        String // lowercase (CHECK in migration 2)
  role         MembershipRole
  tokenHash    String         @unique // sha256 hex; plaintext token is shown once and never stored
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime       @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy  User     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?    @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([email])
  @@index([invitedById])
  @@index([acceptedById])
}

model AuditEvent {
  id          String   @id @default(cuid())
  businessId  String?
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action])
}

// ---- M2: Business Intelligence Profile --------------------------------------------------
// One profile per business. Lifecycle status lives here; content lives in ProfileEntry
// (keyed, validated singletons) and FaqEntry (repeatable knowledge). Every content row keeps
// its working value AND its last approved value; consumers read only approved values.
model BusinessProfile {
  id                String        @id @default(cuid())
  businessId        String        @unique
  status            ProfileStatus @default(DRAFT)
  revision          Int           @default(1)
  statusChangedAt   DateTime      @default(now())
  statusChangedById String?
  statusReason      String? // required while SUSPENDED (CHECK)
  activatedAt       DateTime?
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries        ProfileEntry[]
  faqs           FaqEntry[]
  catalogueItems CatalogueItem[]
}

model ProfileEntry {
  id            String        @id @default(cuid())
  profileId     String
  module        ProfileModule
  key           String
  value         String // working value (what the editor last saved)
  approvedValue String? // last approved value; null = never approved
  state         ReviewState   @default(DRAFT)
  revision      Int           @default(1)
  createdById   String
  updatedById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, module, key])
  @@index([profileId])
}

model FaqEntry {
  id                 String      @id @default(cuid())
  profileId          String
  question           String
  answer             String
  category           String?
  normalizedQuestion String
  isActive           Boolean     @default(true)
  state              ReviewState @default(DRAFT)
  approvedQuestion   String?
  approvedAnswer     String?
  approvedCategory   String?
  revision           Int         @default(1)
  createdById        String
  updatedById        String
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, normalizedQuestion])
  @@index([profileId, isActive])
}

// ---- M5: Structured Product Catalogue & Data Hardening ---------------------------------
model CatalogueItem {
  id             String  @id @default(cuid())
  profileId      String
  name           String
  description    String?
  category       String?
  priceGhs       Decimal @db.Decimal(10, 2)
  currency       String  @default("GHS")
  inStock        Boolean @default(true)
  variants       String?
  sku            String?
  normalizedName String

  // Review & governance (mirrors M2 ProfileEntry/FaqEntry)
  state               ReviewState @default(DRAFT)
  approvedName        String?
  approvedDescription String?
  approvedCategory    String?
  approvedPriceGhs    Decimal?    @db.Decimal(10, 2)
  approvedInStock     Boolean?
  approvedVariants    String?
  approvedSku         String?
  revision            Int         @default(1)

  createdById  String
  updatedById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, normalizedName])
  @@index([profileId, state])
  @@index([profileId, category])
}

// ---- M3: AI Conversation Laboratory (simulation only; nothing here is ever sent to a real customer) ----
model LabConversation {
  id               String                @id @default(cuid())
  businessId       String
  createdById      String
  title            String?
  customerLabel    String                @default("Test customer") // fictional; never real customer data
  status           LabConversationStatus @default(ACTIVE)
  escalationReason String?
  escalatedAt      DateTime?
  resolvedAt       DateTime?
  resolvedById     String?
  lastMessageAt    DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages    LabMessage[]
  generations LabGeneration[]

  @@index([businessId, lastMessageAt])
  @@index([businessId, createdById])
}

// A customer's simulated message, or an assistant message. Assistant rows start as an AI/RULES draft
// (`content` is never edited); approving records the text actually used in the simulation.
model LabMessage {
  id             String         @id @default(cuid())
  conversationId String
  seq            Int
  role           LabMessageRole
  content        String
  createdById    String? // customer rows: the user who typed the simulated message
  createdAt      DateTime       @default(now())

  draftState         LabDraftState?
  source             LabDraftSource?
  resultStatus       LabResultStatus?
  reason             String?
  missingInformation Json?
  escalationReason   String?
  evidence           Json? // server-verified snapshots of the approved records used; never model-supplied text
  profileRevision    Int?
  generationId       String?
  approvedContent    String?
  approvedById       String?
  approvedAt         DateTime?

  conversation LabConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([conversationId, createdAt])
}

// One row per drafting attempt: usage accounting, rate limiting, idempotency and in-flight guard.
model LabGeneration {
  id               String              @id @default(cuid())
  conversationId   String
  businessId       String
  requestedById    String
  idempotencyKey   String
  status           LabGenerationStatus @default(RUNNING)
  usedAi           Boolean             @default(false)
  provider         String?
  model            String?
  errorKind        String?
  latencyMs        Int?
  promptTokens     Int? // null = the provider did not report it (NOT zero)
  completionTokens Int?
  totalTokens      Int?
  inputChars       Int
  createdAt        DateTime            @default(now())
  finishedAt       DateTime?

  conversation LabConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([requestedById, createdAt])
}

// ---- M6: Official WhatsApp Integration (Cloud API) -------------------------------------
// Deliberately SEPARATE tables from the M3 lab: the lab's documented safety property is that
// "nothing here is ever sent to a real customer" and it must never contain real customer data.
// Live WhatsApp traffic gets its own conversation surface with its own control states.
enum WhatsAppConnectionStatus {
  CONNECTED
  DISCONNECTED
}

enum WhatsAppConversationMode {
  OWNER_ONLY // default: inbound messages are shown to the owner, no AI call happens
  AI_ASSIST // opt-in per conversation (M6c); a draft is produced, never sent without an owner action
}

enum WhatsAppConversationStatus {
  ACTIVE
  ESCALATED
  RESOLVED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  RECEIVED
  // M6c: an AI-assist draft waiting for owner review. Never anything but a draft until a
  // person explicitly sends it, which records a NEW row with status SENT (graph wamid).
  DRAFT
  // M8 Phase 2 (ADR 0010): an owner-approved reply persisted during a Meta outage, waiting
  // for `nextAttemptAt`. Never counted toward the send meter (see modules/whatsapp/statuses).
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// M6c: where a draft sits in its small lifecycle. DRAFT = the latest draft being reviewed;
// SUPERSEDED = replaced by a newer draft, marked stale after a takeover, or used by a send.
// The original draft text is never edited (same rule as the lab).
enum WhatsAppMessageDraftState {
  DRAFT
  SUPERSEDED
}

// One per business. phoneNumberId is what every webhook resolves through.
model WhatsAppConnection {
  id                 String                   @id @default(cuid())
  businessId         String                   @unique
  wabaId             String
  phoneNumberId      String                   @unique
  displayPhoneNumber String
  coexistence        Boolean                  @default(false)
  status             WhatsAppConnectionStatus @default(CONNECTED)
  // M8 Phase 2 (ADR 0010): send-path circuit breaker. consecutiveSendFailures counts TRANSIENT
  // send/flush failures; at >= 3 providerDownSince opens the outage banner, reset on success.
  consecutiveSendFailures Int      @default(0)
  providerDownSince       DateTime?
  // Access token encrypted at rest (AES-256-GCM); plaintext never stored or logged.
  tokenCiphertext    String
  tokenExpiresAt     DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  business      Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations WhatsAppConversation[]
  messages      WhatsAppMessage[]

  @@index([wabaId])
}

model WhatsAppConversation {
  id               String                     @id @default(cuid())
  connectionId     String
  businessId       String
  // The WhatsApp user's phone (personal data); visible only to this business's members.
  customerPhone    String
  customerName     String?
  mode             WhatsAppConversationMode   @default(OWNER_ONLY)
  status           WhatsAppConversationStatus @default(ACTIVE)
  escalationReason String?
  lastMessageAt    DateTime                   @default(now())
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  connection  WhatsAppConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages    WhatsAppMessage[]
  generations WhatsAppGeneration[]

  @@unique([connectionId, customerPhone])
  @@index([businessId, lastMessageAt])
  @@index([connectionId, lastMessageAt])
}

// One row per WhatsApp user, business-app or AI-ASSIST-DRAFT message. `wamid` is globally
// unique at Meta (unique index = idempotent dedupe of webhook retries); it is null for M6c
// draft rows, which have no wamid until a person sends them and Graph returns one.
model WhatsAppMessage {
  id             String                   @id @default(cuid())
  conversationId String
  connectionId   String
  direction      WhatsAppMessageDirection
  wamid          String?                  @unique
  text           String?
  type           String                   @default("text")
  status         WhatsAppMessageStatus
  // Coexistence echo: the owner answered from their own WhatsApp Business app, not via LightDesk.
  fromOwnerApp   Boolean                  @default(false)
  errorInfo      Json?
  timestampSent  DateTime?
  createdAt      DateTime                 @default(now())

  // ---- M6c: AI-assist draft review surface (mirrors the M3 lab fields; the values mean the same) ----
  draftState         WhatsAppMessageDraftState?
  source             LabDraftSource?
  resultStatus       LabResultStatus?
  reason             String?
  missingInformation Json?
  escalationReason   String?
  evidence           Json? // server-verified snapshots of the approved records used; never model text
  profileRevision    Int?
  generationId       String?
  approvedContent    String? // records the text that was actually sent (may have been edited by the owner)
  approvedById       String?
  approvedAt         DateTime?

  // ---- M8 Phase 2 (ADR 0010): outage queue bookkeeping. All null after leaving QUEUED. ----
  queuedAt      DateTime? // when the row was queued; null once queued elsewhere
  nextAttemptAt DateTime? // when the flusher may retry; drives the ([status, nextAttemptAt]) index
  attempts      Int       @default(0) // transient attempts made (Exhausted → FAILED at maxAttempts)
  maxAttempts   Int?      // queued-time cap (5 normally; 1 for unknown/unclassified Graph statuses)
  lastErrorKind String?   // TRANSIENT | TRANSIENT_ONCE — never a provider body
  lastErrorAt   DateTime?

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  connection   WhatsAppConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([connectionId, type, status])
  @@index([conversationId, draftState])
  @@index([status, nextAttemptAt])
}

// M6c: one row per LIVE drafting attempt, mirroring M3's LabGeneration. Accounting (tokens,
// latency), idempotency (per conversation + wamid) and the per-business hourly rate cap shared
// with the lab all read from here. `requestedById` is null for system-triggered drafts: a
// WhatsApp webhook has no LightDesk user behind it.
// M6d Embedded Signup: while an owner goes through Meta's signup flow, the exchanged
// long-lived business token must WAIT on the server between the two UI steps (exchange →
// number choice). It is stored AES-256-GCM encrypted (same secret box as connections),
// never sent back to the browser, and is deleted once used or after a short TTL.
// ---- M7: Controlled Pilot rules/controls ---------------------------------------------
// A business enters the pilot ONLY by platform-admin enrollment. While status is not ACTIVE,
// restricted capabilities (AI_ASSIST drafting, the owner send gate) are refused in server code.
// Consent is the owner's explicit console action recording themselves, the time and the
// accepted consent-text version; it is revocable at any time.
enum PilotEnrollmentStatus {
  PENDING_CONSENT
  ACTIVE
  PAUSED
  EXITED
}

model PilotEnrollment {
  id                 String                @id @default(cuid())
  businessId         String                @unique
  status             PilotEnrollmentStatus @default(PENDING_CONSENT)
  consentTextVersion String                @default("v1") @db.VarChar(40)
  consentById        String?
  consentAt          DateTime?
  pausedReason       String?               @db.VarChar(200)
  note               String?               @db.VarChar(500)
  createdById        String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  feedback PilotFeedback[]
}

// Per-business hard usage limits, always <= the platform ceilings in modules/pilot.
// Enforced in server code BEFORE any AI call or Graph request; every breach is audited.
model UsageCaps {
  businessId       String @id
  aiCallsPerDay    Int
  outboundPerMonth Int

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// Owner-to-platform feedback captured during the pilot. Never fed back into the AI.
model PilotFeedback {
  id          String   @id @default(cuid())
  businessId  String
  category    String   @db.VarChar(30)
  comment     String   @db.VarChar(1000)
  createdById String
  createdAt   DateTime @default(now())

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enrollment PilotEnrollment @relation(fields: [businessId], references: [businessId], onDelete: Cascade, map: "PilotFeedback_enrollment_fkey")
  createdBy  User            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
}

model WhatsAppPendingConnection {
  id              String   @id @default(cuid())
  businessId      String   @unique
  tokenCiphertext String
  createdAt       DateTime @default(now())

  // Deliberately NO relation to Business: pending tokens are transient and must not
  // cascade-delete business history; rows are cleaned up by the TTL in the onboarding module.
  @@index([createdAt])
}

model WhatsAppGeneration {
  id               String              @id @default(cuid())
  conversationId   String
  businessId       String
  idempotencyKey   String // the inbound wamid
  status           LabGenerationStatus @default(RUNNING)
  usedAi           Boolean             @default(false)
  provider         String?
  model            String?
  errorKind        String?
  latencyMs        Int?
  promptTokens     Int? // null = the provider did not report it (NOT zero)
  completionTokens Int?
  totalTokens      Int?
  inputChars       Int
  draftMessageId   String?
  requestedById    String? // null = system-triggered (webhook); set for owner-triggered "hand back to AI"
  createdAt        DateTime            @default(now())
  finishedAt       DateTime?

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, idempotencyKey])
  @@index([businessId, createdAt])
}
