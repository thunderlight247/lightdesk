{
  "name": "lightdesk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "prisma generate && next build",
    "dev": "next dev",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "dotenv -e .env -- vitest run --config vitest.integration.config.ts",
    "test": "npm run test:unit && npm run test:integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "bootstrap:admin": "tsx --env-file=.env scripts/bootstrap-admin.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:commits": "bash scripts/check-commits.sh",
    "preview": "export CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=\"$(node -e 'const fs=require(\"node:fs\"),dotenv=require(\"dotenv\"),file=\".env.prod-secrets\";if(!fs.existsSync(file)){console.error(\"Missing .env.prod-secrets with local Neon credentials\");process.exit(1)}const url=dotenv.parse(fs.readFileSync(file,\"utf8\")).NEON_DATABASE_URL;if(!url){console.error(\"NEON_DATABASE_URL missing from .env.prod-secrets\");process.exit(1)}process.stdout.write(url)')\" && opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "^15.5.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.151.3"
  }
}
