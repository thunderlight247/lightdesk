# Copy to .env — never commit .env. No real credentials belong in this file.

# Development database (see docker-compose.yml)
DATABASE_URL="postgresql://lightdesk:lightdesk_dev_only@localhost:55433/lightdesk?schema=public"

# Integration tests TRUNCATE tables. The database name MUST contain "test".
TEST_DATABASE_URL="postgresql://lightdesk:lightdesk_dev_only@localhost:55433/lightdesk_test?schema=public"

# Public origin of the app (used for invitation links and same-origin checks)
APP_URL="http://localhost:3000"

# Optional tuning
SESSION_TTL_DAYS=7
INVITATION_TTL_HOURS=72

# Login throttling (M8 Phase 3): failed-attempt budgets over one rolling window.
# Defaults: 10 failures per client ip, 5 per attempted email, 10-minute window.
LOGIN_MAX_FAILURES_PER_IP=10
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_FAILURE_WINDOW_MINUTES=10

# Bootstrap of the first administrator is done with a CLI command; the password
# is NOT stored here. See README "Bootstrap the first administrator".
# Lab AI provider (M3): "gemini" (default) or "deepseek". When unset, gemini is used if it
# has a key, otherwise deepseek. Provider keys are server-side only, never client-bundled.
#LAB_AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# DeepSeek is the second provider (docs §5 AI provider strategy).
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
LAB_AI_TIMEOUT_MS=30000
LAB_RATE_USER_PER_MINUTE=6
LAB_RATE_BUSINESS_PER_HOUR=60

# ---- WhatsApp Cloud API (M6) — real credentials go ONLY in .env (never committed) ----
# Meta app dashboard → App settings → Basic
WHATSAPP_APP_ID=""
# Meta Embedded Signup configuration id (WhatsApp → Embedded signup). Without it the owner connect button stays hidden.
WHATSAPP_SIGNUP_CONFIG_ID=""
# Required for POST webhook HMAC-SHA256 verification (x-hub-signature-256).
# Keep server-side only; the route rejects webhook events when this is missing.
WHATSAPP_APP_SECRET=""
# Access token that can manage the WABA (system-user token recommended; check "whatsapp_business_messaging")
WHATSAPP_ACCESS_TOKEN=""
# WhatsApp Business Account id (WABA), numeric — WhatsApp → API Setup screen
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Phone number id (NOT the display number), numeric — WhatsApp → API Setup screen
WHATSAPP_PHONE_NUMBER_ID=""
# Arbitrary string you invent; used for webhook GET verification later
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Graph API version; v26.0 is current as of 2026-10 (verify at graph-api changelog when upgrading)
WHATSAPP_GRAPH_API_VERSION="v26.0"

# Outbox flush endpoint (ADR 0010, M8 Phase 2): bearer token for the cron-style
# POST /api/whatsapp/outbox/flush drain. Unset = the endpoint is disabled and the
# queue is drained by console reads alone. Must be at least 32 characters when set.
WHATSAPP_OUTBOX_FLUSH_TOKEN=""
